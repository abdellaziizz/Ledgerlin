# Copy to config.env for local `npm run dev`, or to .env for docker compose.
# Never commit the real file (both are git-ignored).

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Either DATABASE_URL ...
# DATABASE_URL=postgres://ledgerline:ledgerline@127.0.0.1:5433/ledgerline
# ... or the individual settings:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ledgerline
DB_USER=postgres
DB_PASSWORD=change-me

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
# Short-lived access tokens (no refresh tokens).
JWT_EXPIRES_IN=1h

# locks (default): SELECT ... FOR UPDATE in id order. serializable: SERIALIZABLE + retry on 40001.
TRANSFER_MODE=locks
LOG_LEVEL=info

# docker compose only
POSTGRES_PASSWORD=ledgerline
