# Base path the browser uses for API calls. Keep the default during development:
# Vite proxies /api to VITE_API_PROXY_TARGET, which avoids CORS (the backend sets no CORS headers).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server forwards /api requests (the Express backend; it listens on 127.0.0.1:$PORT).
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
